// ─────────────────────────────────────────────────────────────────────────────
//  nextflow.config  —  Global configuration for the Bionl_lean_db pipeline
// ─────────────────────────────────────────────────────────────────────────────

manifest {
    name        = 'bionl_lean_db_export'
    description = 'Generates database-ready variants and coverage tables via variant extraction and mosdepth per-base coverage'
    version     = '1.2.0'
    nextflowVersion = '>=23.04.0'
}

// ── Default parameters ────────────────────────────────────────────────────────



// ── Process defaults ──────────────────────────────────────────────────────────
process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    // Label-based resource tiers
    withLabel: 'low_cpu' {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }
    withLabel: 'med_cpu' {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }
    withLabel: 'high_cpu' {
        cpus   = 16
        memory = '32 GB'
        time   = '8h'
    }

    // Per-process container directives
    withName: 'MOSDEPTH_PERBASE' {
        container = 'quay.io/biocontainers/mosdepth:0.3.6--hd299d5a_0'
    }
    withName: 'PERBASE_TO_COVERAGE|EXTRACT_VARIANTS' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
    }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled          = false
        process.conda          = 'environment.yml'   // provide your own
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        params.samplesheet = 'data/samplesheet.tsv'
        params.bins_bed    = 'data/MANE_bins_unique.bed'
        params.outdir      = 'test_results'
        params.threads     = 2
    }
}

// ── Resume / caching ──────────────────────────────────────────────────────────
resume = true

// ── Reporting ─────────────────────────────────────────────────────────────────

