// ─────────────────────────────────────────────────────────────────────────────
//  nextflow.config  —  Global configuration for the Bionl_lean_db pipeline
// ─────────────────────────────────────────────────────────────────────────────

manifest {
    name        = 'bionl_lean_db_export'
    description = 'Generates database-ready variants and coverage tables via VEP annotation, variant extraction, and mosdepth coverage'
    version     = '1.1.0'
    nextflowVersion = '>=23.04.0'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {

    // ── VEP resources
    //vep_cache               = "/home/alkhatib/vep_data"
    //vep_fasta               = "/home/alkhatib/vep_data/Homo_sapiens.GRCh38.dna.toplevel.fa"
    //vep_fasta_fai           = "/home/alkhatib/vep_data/Homo_sapiens.GRCh38.dna.toplevel.fa.fai"
    //vep_plugins             = "/home/alkhatib/vep_plugins"

    // ── VEP plugin / custom annotation files
    //revel_vcf               = "/home/alkhatib/vep_data/new_tabbed_revel_grch38.tsv.gz"
    //revel_vcf_tbi           = "/home/alkhatib/vep_data/new_tabbed_revel_grch38.tsv.gz.tbi"
    //alpha_missense_vcf      = "/home/alkhatib/vep_data/AlphaMissense_hg38.tsv.gz"
    //alpha_missense_vcf_tbi  = "/home/alkhatib/vep_data/AlphaMissense_hg38.tsv.gz.tbi"
    //clinvar_vcf             = "/home/alkhatib/vep_data/ClinVar/clinvar.chr.vcf.gz"
    //clinvar_vcf_tbi         = "/home/alkhatib/vep_data/ClinVar/clinvar.chr.vcf.gz.tbi"
    //spliceai_snv_vcf        = "/home/alkhatib/vep_data/SpliceAI_hg38.tsv.gz"
    //spliceai_snv_vcf_tbi    = "/home/alkhatib/vep_data/SpliceAI_hg38.tsv.gz.tbi"
    //spliceai_indel_vcf      = "/home/alkhatib/vep_data/SpliceAI_hg38.tsv.gz"
    //spliceai_indel_vcf_tbi  = "/home/alkhatib/vep_data/SpliceAI_hg38.tsv.gz.tbi"
    //bayesdel_vcf            = "/home/alkhatib/vep_data/BayesDel_hg38.tsv.gz"
    //bayesdel_vcf_tbi        = "/home/alkhatib/vep_data/BayesDel_hg38.tsv.gz.tbi"

    vep_cache           = "gs://vep-data-vaic/vep_data/cache"
    vep_fasta           = "gs://vep-data-vaic/vep_data/fasta/Homo_sapiens.GRCh38.dna.toplevel.fa"
    vep_fasta_fai           = "gs://vep-data-vaic/vep_data/fasta/Homo_sapiens.GRCh38.dna.toplevel.fa.fai"
    revel_vcf           = "gs://vep-data-vaic/vep_data/plugins/GRCh38/new_tabbed_revel_grch38.tsv.gz"
    revel_vcf_tbi       = "gs://vep-data-vaic/vep_data/plugins/GRCh38/new_tabbed_revel_grch38.tsv.gz.tbi"
    alpha_missense_vcf  = "gs://vep-data-vaic/vep_data/plugins/GRCh38/AlphaMissense_hg38.tsv.gz"
    alpha_missense_vcf_tbi = "gs://vep-data-vaic/vep_data/plugins/GRCh38/AlphaMissense_hg38.tsv.gz.tbi"
    clinvar_vcf         = "gs://vep-data-vaic/vep_data/plugins/GRCh38/clinvar.chr.vcf.gz"
    clinvar_vcf_tbi     = "gs://vep-data-vaic/vep_data/plugins/GRCh38/clinvar.chr.vcf.gz.tbi"
    spliceai_snv_vcf    = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.snv.hg38.vcf.gz"
    spliceai_snv_vcf_tbi = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.snv.hg38.vcf.gz.tbi"
    spliceai_indel_vcf  = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.indel.hg38.vcf.gz"
    spliceai_indel_vcf_tbi = "gs://vep-data-vaic/vep_data/plugins/GRCh38/spliceai_scores.masked.indel.hg38.vcf.gz.tbi"
    bayesdel_vcf        = "gs://vep-data-vaic/vep_data/plugins/GRCh38/BayesDel_addAF_GRCh38_complete.txt.gz"
    bayesdel_vcf_tbi    = "gs://vep-data-vaic/vep_data/plugins/GRCh38/BayesDel_addAF_GRCh38_complete.txt.gz.tbi"
    vep_plugins         = "gs://vep-data-vaic/vep_plugins"

    // ── vaic-service API (for DB loading steps) ──
    vaic_service_url    = null
    vaic_api_key        = null

    // ── Output directory ──
    outdir              = 'results'
}


// ── Process defaults ──────────────────────────────────────────────────────────
process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    // Label-based resource tiers
    withLabel: 'low_cpu' {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }
    withLabel: 'med_cpu' {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }
    withLabel: 'high_cpu' {
        cpus   = 16
        memory = '32 GB'
        time   = '8h'
    }

    // Per-process container directives (uncomment for your environment)
    //withName: 'VEP_ANNOTATE' {
    //     container = 'ensemblorg/ensembl-vep:release_114.2'
    //}
    withName: 'VEP_ANNOTATE' {
         container = 'quay.io/biocontainers/ensembl-vep:115.2--pl5321h2a3209d_1'
    }
    withName: 'MOSDEPTH_THRESHOLDS' {
         container = 'quay.io/biocontainers/mosdepth:0.3.6--hd299d5a_0'
    }
    withName: 'EXTRACT_VARIANTS|CONVERT_THRESHOLDS' {
        container = 'docker.io/alkhatib93/python-bionl:v1.0'
    }
    withName: 'LOAD_VARIANTS|LOAD_DENSE_DEPTH' {
        container = 'python:3.12'
    }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled          = false
        process.conda          = 'environment.yml'   // provide your own
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        params.samplesheet = 'data/samplesheet.tsv'
        params.bins_bed    = 'data/MANE_bins_unique.bed'
        params.outdir      = 'test_results'
        params.threads     = 2
    }
}

// ── Resume / caching ──────────────────────────────────────────────────────────
resume = true

// ── Reporting ─────────────────────────────────────────────────────────────────
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss'
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
