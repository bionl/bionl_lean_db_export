// ─────────────────────────────────────────────────────────────────────────────
//  nextflow.config  —  Global configuration for the db-tables pipeline
// ─────────────────────────────────────────────────────────────────────────────

manifest {
    name        = 'bionl_lean_db_export'
    description = 'Generates database-ready variants and coverage tables via VEP annotation, variant extraction, and mosdepth coverage'
    version     = '1.1.0'
    nextflowVersion = '>=23.04.0'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {
    // ── Core ──────────────────────────────────────────────────────────────────
    samplesheet             = "samplesheet.tsv"
    outdir                  = "results"
    threads                 = 4
    mosdepth_thresholds     = "10,20,30"

    // ── Coverage ──────────────────────────────────────────────────────────────
    bins_bed                = "MANE_bins_unique.bed"

    // ── VEP resources (set via --param or params file) ────────────────────────
    vep_cache               = null
    vep_fasta               = null
    vep_fasta_fai           = null
    vep_plugins             = null

    // ── VEP plugin / custom annotation files ─────────────────────────────────
    revel_vcf               = null
    revel_vcf_tbi           = null
    alpha_missense_vcf      = null
    alpha_missense_vcf_tbi  = null
    clinvar_vcf             = null
    clinvar_vcf_tbi         = null
    spliceai_snv_vcf        = null
    spliceai_snv_vcf_tbi    = null
    spliceai_indel_vcf      = null
    spliceai_indel_vcf_tbi  = null
    bayesdel_vcf            = null
    bayesdel_vcf_tbi        = null
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    // Label-based resource tiers
    withLabel: 'low_cpu' {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }
    withLabel: 'med_cpu' {
        cpus   = params.threads
        memory = '8 GB'
        time   = '2h'
    }
    withLabel: 'high_cpu' {
        cpus   = params.threads
        memory = '16 GB'
        time   = '8h'
    }

    // Per-process container directives (uncomment for your environment)
    // withName: 'VEP_ANNOTATE' {
    //     container = 'ensemblorg/ensembl-vep:release_110.1'
    // }
    // withName: 'MOSDEPTH_THRESHOLDS' {
    //     container = 'quay.io/biocontainers/mosdepth:0.3.6--hd299d5a_0'
    // }
    // withName: 'EXTRACT_VARIANTS|CONVERT_THRESHOLDS' {
    //     container = 'quay.io/biocontainers/python:3.11'
    // }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = '--account=myproject'
        executor {
            queueSize    = 50
            pollInterval = '30 sec'
        }
    }

    conda {
        conda.enabled          = true
        process.conda          = 'environment.yml'   // provide your own
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        params.samplesheet = 'test/samplesheet.tsv'
        params.bins_bed    = 'test/MANE_bins_unique.bed'
        params.outdir      = 'test_results'
        params.threads     = 2
    }
}

// ── Resume / caching ──────────────────────────────────────────────────────────
resume = true

// ── Reporting ─────────────────────────────────────────────────────────────────
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
